<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<AssemblyName>MvvmAIO.Prism.Bcl.Commands</AssemblyName>
		<RootNamespace>Prism</RootNamespace>
		<LangVersion>14.0</LangVersion>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<PackageId>MvvmAIO.Prism.Bcl.Commands</PackageId>
    <Version>0.8.1</Version>
		<Authors>MvvmAIO;Skymly;wys0610</Authors>
		<Description>Prism 8 compatibility command library for AsyncDelegateCommand and IAsyncCommand. Install this package manually when using Prism.Core 8.1.97 with MvvmAIO.Prism.SourceGenerators.</Description>
		<PackageTags>prism;mvvm;commands;asyncdelegatecommand;prism8</PackageTags>
		<PackageProjectUrl>https://github.com/MvvmAIO/Prism.SourceGenerators</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MvvmAIO/Prism.SourceGenerators</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="all" />
		<PackageReference Include="Prism.Core" Version="8.1.97" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>

