<Project>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <PackageId>Prism.SourceGenerators</PackageId>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    Multi-targeting for different Roslyn versions, following the CommunityToolkit.Mvvm pattern.
    Each Roslyn-versioned project uses the naming scheme: Prism.SourceGenerators.Roslyn<MAJOR><MINOR2><PATCH>
    The suffix sets PrismSourceGeneratorRoslynVersion, which pins Microsoft.CodeAnalysis.CSharp and
    Microsoft.CodeAnalysis.CSharp.Workspaces. Microsoft.CodeAnalysis.Analyzers follows the same line
    via PrismSourceGeneratorCodeAnalysisAnalyzersVersion (3.11.x for Roslyn 4.x, 5.3.x once Roslyn >= 5.0).
  -->
  <PropertyGroup>
    <AssemblyName>$(MSBuildProjectName.Substring(0, $([MSBuild]::Subtract($(MSBuildProjectName.Length), 11))))</AssemblyName>

    <PrismSourceGeneratorRoslynMajorVersion>$(MSBuildProjectName.Substring($([MSBuild]::Subtract($(MSBuildProjectName.Length), 4)), 1))</PrismSourceGeneratorRoslynMajorVersion>
    <PrismSourceGeneratorRoslynMinorVersion>$(MSBuildProjectName.Substring($([MSBuild]::Subtract($(MSBuildProjectName.Length), 3)), 2))</PrismSourceGeneratorRoslynMinorVersion>
    <PrismSourceGeneratorRoslynPatchVersion>$(MSBuildProjectName.Substring($([MSBuild]::Subtract($(MSBuildProjectName.Length), 1)), 1))</PrismSourceGeneratorRoslynPatchVersion>
    <PrismSourceGeneratorRoslynVersion>$(PrismSourceGeneratorRoslynMajorVersion).$(PrismSourceGeneratorRoslynMinorVersion).$(PrismSourceGeneratorRoslynPatchVersion)</PrismSourceGeneratorRoslynVersion>

    <!-- Microsoft.CodeAnalysis.CSharp / .Workspaces use $(PrismSourceGeneratorRoslynVersion). Analyzers ship on a different cadence: keep 3.11.x for Roslyn 4.x lines, newer set for Roslyn 5+. -->
    <PrismSourceGeneratorCodeAnalysisAnalyzersVersion>3.11.0</PrismSourceGeneratorCodeAnalysisAnalyzersVersion>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals($(PrismSourceGeneratorRoslynVersion), 4.3.1))">$(DefineConstants);ROSLYN_4_3_1_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals($(PrismSourceGeneratorRoslynVersion), 4.12.0))">$(DefineConstants);ROSLYN_4_12_0_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals($(PrismSourceGeneratorRoslynVersion), 5.0.0))">$(DefineConstants);ROSLYN_5_0_0_OR_GREATER</DefineConstants>

    <NoWarn Condition="$([MSBuild]::VersionLessThan($(PrismSourceGeneratorRoslynVersion), 5.0.0))">$(NoWarn);RS2003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals($(PrismSourceGeneratorRoslynVersion), 5.0.0))">
    <PrismSourceGeneratorCodeAnalysisAnalyzersVersion>5.3.0</PrismSourceGeneratorCodeAnalysisAnalyzersVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      RS1038: "Compiler extension assemblies should not depend on Workspaces". Suppressed because we
      bundle a CodeFixProvider in the same DLL as the analyzer + generator. The host (VS / dotnet IDE)
      always loads Workspaces alongside, so this is safe in practice.
    -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
    <!--
      Polyfill types are internal; this assembly uses InternalsVisibleTo (tests). Embedded attributes
      keep polyfill internals from colliding across friend assemblies (see Polyfill consuming.md).
    -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="$(PrismSourceGeneratorCodeAnalysisAnalyzersVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(PrismSourceGeneratorRoslynVersion)" PrivateAssets="all" Pack="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(PrismSourceGeneratorRoslynVersion)" PrivateAssets="all" Pack="false" />
    <PackageReference Include="Polyfill" Version="$(PolyfillVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
